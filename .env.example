# ===== 数据库 =====
# 默认 SQLite，零运维，无需改动。
# 切换 MySQL：安装 pip install pymysql，并改为下方格式（表结构无需改动）：
#   DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/interview_memory
DATABASE_URL=sqlite:///./data/interview_memory.db

# ===== Agent 判题接口 =====
# 方式 1：外部 Agent HTTP 回调（优先）
# 留空则使用方式 2 或本地启发式占位。
AGENT_JUDGE_URL=
AGENT_JUDGE_TOKEN=

# 方式 2：直接调用 OpenAI 兼容 LLM 接口进行判题
# 若 AGENT_JUDGE_URL 为空且 LLM 配置完整，则自动使用 LLM 判题。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key
LLM_MODEL=gpt-4o-mini

# ===== SMTP 邮件（QQ 邮箱示例）=====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=1
SMTP_USER=your_qq@qq.com
# 腾讯邮箱需使用「授权码」而非登录密码
SMTP_PASSWORD=your_auth_code

# ===== 应用 =====
APP_BASE_URL=http://localhost:8000

# ===== 图片存储 =====
# local（默认）：存 data/images/，零运维，前端同源访问。
# s3：对象存储，兼容 AWS S3 / 阿里云 OSS / 腾讯云 COS / MinIO / Cloudflare R2。
STORAGE_BACKEND=local
# 以下仅 STORAGE_BACKEND=s3 时需要：
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 可选：对象存储绑定的自定义域名/CDN（填了则返回该域名下 URL，否则用 endpoint 直链）
S3_PUBLIC_URL=
